# Copiez ce fichier en .env (a la racine, ou dans backend/ selon votre outil
# de chargement d'environnement) et renseignez vos propres valeurs.
# Ne JAMAIS commiter le fichier .env reel (voir .gitignore).

# Cle API OpenAI - requise pour la brique 4 (generation), voir
# backend/app/llm_client.py. Sans cle, seul le chemin d'abstention de la
# pipeline fonctionne (aucun appel LLM n'est necessaire pour repondre "je ne
# sais pas").
OPENAI_API_KEY=

# Modele OpenAI utilise pour les appels structures (voir llm_client.py).
OPENAI_MODEL=gpt-4o-mini

# URL du backend FastAPI, utilisee par le frontend Streamlit
# (frontend/streamlit_app.py) pour ses appels HTTP.
BACKEND_URL=http://localhost:8000
